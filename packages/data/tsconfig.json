{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noEmit": true,
        "skipLibCheck": true,
        "baseUrl": "../..",
        "paths": {
            "@family-organizer/shared-core": ["packages/shared-core/src/index.ts"]
        }
    },
    "include": ["src"]
}
